# Copy to .env (never commit .env).
# EVERYTHING BELOW IS OPTIONAL. With this file empty (or absent) the app scans ALL coins, estimates liquidation
# clusters, paper-trades and backtests using Binance PUBLIC endpoints only - no Binance key, no liquidation key.

# Binance USDⓈ-M public market data needs NO key. Only needed for live order placement.
# Use a key WITHOUT withdrawal permission; read-only for analysis.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram alerts (set alerts.telegram_enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Licensed liquidation-heatmap vendor key (ONLY for liquidation.provider: http_json). Not needed for public_model.
LIQ_API_KEY=

# LIVE ORDERS are blocked unless this is EXACTLY the string below AND config execution.mode: live.
# Leave empty. Paper trading does not need it.
ALLOW_LIVE_ORDERS=
